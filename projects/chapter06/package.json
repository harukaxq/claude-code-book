{
	"name": "commerce",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "bun --bun run vite build",
		"preview": "bun --bun run vite preview",
		"prepare": "bun --bun run svelte-kit sync || echo ''",
		"check": "bun --bun run svelte-kit sync && bun --bun run svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun --bun run svelte-kit sync && bun --bun run svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun --bun run eslint .",
		"format": "bun --bun run prettier --write .",
		"format:check": "bun --bun run prettier --check .",
		"test": "bun --bun run vitest run",
		"test:watch": "bun --bun run vitest",
		"db:generate": "bun --bun run drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"seed": "bun scripts/seed.ts",
		"reset:db": "bun scripts/reset-db.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bun": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.7.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1092.0",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	}
}
